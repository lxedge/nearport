{
  "manifest_version": 3,
  "name": "NearPort",
  "version": "0.1.0",
  "description": "A NEAR wallet Chrome extension",
  "action": {
    "default_popup": "index.html",
    "default_title": "NearPort"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
